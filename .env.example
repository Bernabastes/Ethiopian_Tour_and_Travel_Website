# ─────────────────────────────────────────────────────────────
# Copy this file to ".env" and fill in the values.
#   cp .env.example .env
# Only DATABASE_URL + DIRECT_URL + NEXTAUTH_SECRET are needed to run the backend.
# Everything else is optional and falls back gracefully if left blank.
# ─────────────────────────────────────────────────────────────

# --- Database (Supabase → Project Settings → Database → Connection string) ---
# Use the "Transaction" pooler URL (port 6543) for DATABASE_URL,
# and the "Session"/direct URL (port 5432) for DIRECT_URL (used by migrations).
DATABASE_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxx:[PASSWORD]@aws-0-region.pooler.supabase.com:5432/postgres"

# --- Admin login (used by the seed script to create the first owner account) ---
ADMIN_EMAIL="admin@habeshaheritagetours.com"
ADMIN_PASSWORD="change-this-strong-password"

# --- Auth (NextAuth) ---
# Generate a secret with:  npx auth secret   (or any 32+ char random string)
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"

# --- Public site URL ---
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Email (Resend → API Keys). Without this, emails log to the console. ---
RESEND_API_KEY=""
EMAIL_FROM="Habesha Heritage Tours <onboarding@resend.dev>"
ADMIN_NOTIFY_EMAILS="info@habeshaheritagetours.com"

# --- Payments: Stripe (test mode → Developers → API keys) ---
STRIPE_SECRET_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Payments: PayPal (https://developer.paypal.com/dashboard/) ---
# Sandbox credentials for testing; set PAYPAL_MODE=live for production.
# Register webhook URL: https://YOUR-SITE/api/payment/paypal/webhook
# Subscribe to: Payment capture completed
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="sandbox"              # sandbox | live
PAYPAL_WEBHOOK_ID=""               # Webhook ID from PayPal dashboard (required in production)

# --- Payments: Chapa (Ethiopian gateway — https://dashboard.chapa.co) ---
# Use CHASECK_TEST-... for test mode, CHASECK-... for live.
# Register callback URL:  https://YOUR-SITE/api/payment/chapa/callback
# Register webhook URL:   https://YOUR-SITE/api/payment/chapa/webhook
CHAPA_SECRET_KEY=""
CHAPA_USD_ETB_RATE=""             # optional; falls back to display rate in data/company.ts

# --- Payments: telebirr (Ethio Telecom Web Payment / H5) ---
# Provided by Ethio Telecom after merchant onboarding. Leave blank to disable
# (the app still builds and just hides the telebirr button).
# Confirm the two base URLs and field names against your integration PDF.
TELEBIRR_BASE_URL=""              # API host, e.g. https://app.ethiomobilemoney.et:2121/  (trailing slash)
TELEBIRR_WEB_BASE_URL=""          # H5 checkout host (trailing slash)
TELEBIRR_FABRIC_APP_ID=""         # X-APP-Key
TELEBIRR_APP_SECRET=""
TELEBIRR_MERCHANT_APP_ID=""       # appid
TELEBIRR_SHORT_CODE=""            # merch_code
TELEBIRR_PRIVATE_KEY=""           # your RSA private key (PEM; \n-escaped on one line is fine)
TELEBIRR_PUBLIC_KEY=""            # telebirr's RSA public key (PEM) — used to verify notify callbacks
TELEBIRR_USD_ETB_RATE=""          # fixed conversion rate, e.g. 158.5 (bookings are stored in USD)
