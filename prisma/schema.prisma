// Prisma schema for Habesha Heritage Tours — Postgres (Supabase).
// Run after setting DATABASE_URL + DIRECT_URL in .env:
//   npx prisma generate
//   npx prisma migrate dev --name init
//   npm run db:seed

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")  // pooled connection (Supabase port 6543) for the app
  directUrl = env("DIRECT_URL")    // direct connection (port 5432) for migrations
}

// ───────────────────────── Content models ─────────────────────────
// Rich nested content (itinerary, pricing, route, images, …) is stored as JSON
// to keep the schema simple while staying fully queryable by slug.

model Tour {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  category         String
  durationDays     Int
  durationNights   Int
  priceFromUsd     Int
  difficulty       String
  rating           Float
  reviewCount      Int
  groupSizeMax     Int
  startLocation    String
  endLocation      String
  shortDescription String
  description      Json
  highlights       Json
  images           Json
  itinerary        Json
  included         Json
  excluded         Json
  pricing          Json
  route            Json
  destinations     Json
  featured         Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Destination {
  id                  String   @id @default(cuid())
  slug                String   @unique
  name                String
  region              String
  keyFact             String
  overview            String
  attractions         Json
  bestTime            String
  gettingThere        String
  image               String
  lat                 Float
  lng                 Float
  distanceFromAddisKm Int
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Guide {
  id              String   @id @default(cuid())
  slug            String   @unique
  name            String
  title           String
  yearsExperience Int
  licenseNumber   String
  specialties     Json
  languages       Json
  bio             String
  rating          Float
  image           String
  createdAt       DateTime @default(now())
}

model Review {
  id          String   @id @default(cuid())
  name        String
  country     String
  countryFlag String
  rating      Int
  tour        String
  date        DateTime
  text        String
  approved    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

// ───────────────────────── Transactional models ─────────────────────────

enum BookingStatus {
  PENDING
  CONFIRMED
  PAID
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  DEPOSIT_PAID
  PAID
  REFUNDED
}

model Booking {
  id            String        @id @default(cuid())
  reference     String        @unique
  fullName      String
  email         String
  phone         String
  isWhatsapp    Boolean       @default(false)
  country       String
  tourSlug      String
  tourName      String
  travelDate    DateTime
  adults        Int           @default(1)
  children      Int           @default(0)
  infants       Int           @default(0)
  accommodation String        @default("standard")
  requests      String?
  heardAbout    String?
  totalUsd      Int
  depositUsd    Int
  status        BookingStatus @default(PENDING)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentRef    String?       // Stripe/PayPal id
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([status])
  @@index([travelDate])
}

enum ContactStatus {
  NEW
  REPLIED
  ARCHIVED
}

model ContactMessage {
  id        String        @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  tour      String?
  message   String
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())

  @@index([status])
}

enum AvailabilityStatus {
  AVAILABLE
  LIMITED
  FULL
  OFF
}

model Availability {
  id       String             @id @default(cuid())
  tourSlug String
  date     DateTime           @db.Date
  status   AvailabilityStatus @default(AVAILABLE)
  spots    Int                @default(8)

  @@unique([tourSlug, date])
  @@index([tourSlug])
}

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("owner")
  createdAt    DateTime @default(now())
}

// ───────────────────────── CMS content ─────────────────────────

model BlogPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String
  content         String    @db.Text
  coverImage      String
  category        String
  author          String    @default("Habesha Heritage Tours")
  readMinutes     Int       @default(5)
  metaTitle       String?
  metaDescription String?
  published       Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([published])
}

model GalleryImage {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  category  String   @default("Landscapes")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  @@index([category])
}
